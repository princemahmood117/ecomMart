generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  age       Int
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  photoUrl  String   @default("https://i.ibb.co.com/pjm1Dqq3/user.png")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  brand       String
  description String
  price       Float
  quantity    Int
  images      String[]
  benefits    String[]
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  fullName      String
  phone         String
  email         String
  location      String
  status        OrderStatus @default(PENDING)
  items         OrderItem[]
  isConfirmed Boolean @default(false)
  totalPrice    Float
  createdAt     DateTime    @default(now())
  
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
}